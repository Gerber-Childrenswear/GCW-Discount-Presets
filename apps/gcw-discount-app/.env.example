SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here
SHOPIFY_APP_SCOPES=write_discounts,read_discounts,write_functions,read_functions
SHOPIFY_APP_HOST=localhost:8081
SESSION_ENCRYPTION_KEY=replace_with_a_long_random_secret
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret
PORT=8081
LOG_LEVEL=info

# GitHub OAuth callback URL: https://your-app-domain/api/auth/github/callback
# The GitHub account ncassidy233 exclusively has administrator backend access.
